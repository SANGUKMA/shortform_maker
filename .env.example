# Claude API (console.anthropic.com → API Keys) — 하이라이트 선택
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (platform.openai.com → API keys) — Whisper 음성 전사. 별도 Whisper 키 없이 일반 OpenAI 키 하나로 사용
OPENAI_API_KEY=your_openai_api_key_here

# YouTube OAuth (Google Cloud Console → Web Application 타입) — YouTube 업로드를 쓸 때만 필요
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# 앱 URL (Railway 배포 시 실제 URL로 변경)
APP_URL=https://shortformmaker-production.up.railway.app

# 클립 경계 정밀 보정 (wav2vec2) — 이 Mac에서만 true. requirements-align.txt 설치 필요, Railway에서는 설정하지 않음
ALIGN_ENABLED=false
